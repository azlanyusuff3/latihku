ifficulty":"mudah","question":"The opposite of “strong” is…","correct":"weak","answers":["small","hot","weak","happy"],"explanation":"“weak” is the opposite of “strong”.","concept":"ant-strong","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"}]}