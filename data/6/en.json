{"version":"10.0","level":"6","subject":"en","questions":[{"id":"EN-6-08948","topic":"Sentence","difficulty":"mudah","question":"Choose the correct question.","correct":"Where are you going?","answers":["Going where you are?","Where is you going?","Where you are going.","Where are you going?"],"explanation":"Questions with “you” use “are” before the subject.","concept":"sentence-2","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08730","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “early” is…","correct":"late","answers":["dirty","big","late","happy"],"explanation":"“late” is the opposite of “early”.","concept":"ant-early","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08873","topic":"Tenses","difficulty":"sederhana","question":"Last night, they ___ a movie.","correct":"watched","answers":["watching","watches","watch","watched"],"explanation":"“Last night” signals past tense.","concept":"tense-3","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08926","topic":"Prepositions","difficulty":"mudah","question":"The shoes are ___ the bed.","correct":"under","answers":["between","from","under","to"],"explanation":"“under” fits the location or direction in this sentence.","concept":"prep-5","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08748","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “young” is…","correct":"old","answers":["strong","old","weak","dirty"],"explanation":"“old” is the opposite of “young”.","concept":"ant-young","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08864","topic":"Tenses","difficulty":"sederhana","question":"Tomorrow, we ___ visit the museum.","correct":"will","answers":["did","was","has","will"],"explanation":"“Tomorrow” indicates future time; “will” is appropriate.","concept":"tense-2","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08717","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “big” is…","correct":"small","answers":["early","small","clean","cold"],"explanation":"“small” is the opposite of “big”.","concept":"ant-big","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08740","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “strong” is…","correct":"weak","answers":["weak","cold","dirty","old"],"explanation":"“weak” is the opposite of “strong”.","concept":"ant-strong","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08898","topic":"Prepositions","difficulty":"mudah","question":"The cat is ___ the box.","correct":"in","answers":["from","with","in","to"],"explanation":"“in” fits the location or direction in this sentence.","concept":"prep-1","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08793","topic":"Grammar","difficulty":"mudah","question":"She ___ to school every day.","correct":"goes","answers":["goes","go","gone","going"],"explanation":"With “she” in the simple present, use “goes”.","concept":"grammar-0","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08831","topic":"Grammar","difficulty":"mudah","question":"He ___ a blue bicycle.","correct":"has","answers":["has","have","are","is"],"explanation":"Use “has” with he/she/it in the simple present.","concept":"grammar-4","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-09005","topic":"Comprehension","difficulty":"sederhana","question":"Read: “Adam found a wallet and gave it to his teacher.”\n\nWhat quality did Adam show?","correct":"Honesty.","answers":["Carelessness.","Anger.","Honesty.","Laziness."],"explanation":"Returning a lost wallet shows honesty.","concept":"comp-3","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08972","topic":"Comprehension","difficulty":"sederhana","question":"Read: “Ben has a red bicycle. He rides it to the park every Sunday.”\n\nWhat colour is Ben’s bicycle?","correct":"red","answers":["red","yellow","green","blue"],"explanation":"The passage says the bicycle is red.","concept":"comp-0","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08966","topic":"Sentence","difficulty":"mudah","question":"Choose the sentence with correct punctuation.","correct":"My name is Hana.","answers":["My name is Hana.","both","none","My name is Hana"],"explanation":"A sentence starts with a capital letter and ends with punctuation.","concept":"sentence-3","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08833","topic":"Grammar","difficulty":"mudah","question":"My sister and I ___ pupils.","correct":"are","answers":["are","is","was","am"],"explanation":"A compound plural subject takes “are”.","concept":"grammar-5","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08817","topic":"Grammar","difficulty":"mudah","question":"These ___ my books.","correct":"are","answers":["be","are","am","is"],"explanation":"“These” is plural, so use “are”.","concept":"grammar-3","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08813","topic":"Grammar","difficulty":"mudah","question":"I have ___ apple.","correct":"an","answers":["an","some","the","a"],"explanation":"Use “an” before a word that begins with a vowel sound.","concept":"grammar-2","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08919","topic":"Prepositions","difficulty":"mudah","question":"The picture is ___ the wall.","correct":"on","answers":["on","to","under","from"],"explanation":"“on” fits the location or direction in this sentence.","concept":"prep-4","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08929","topic":"Sentence","difficulty":"mudah","question":"Choose the correct sentence.","correct":"She likes reading books.","answers":["She like reading books.","She likes reading books.","Likes she reading books.","She books likes reading."],"explanation":"The subject and verb agree, and the word order is correct.","concept":"sentence-0","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08856","topic":"Tenses","difficulty":"sederhana","question":"Every morning, Siti ___ milk.","correct":"drinks","answers":["drank","drinking","drinks","drink"],"explanation":"A repeated daily action uses the simple present: “drinks”.","concept":"tense-1","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08768","topic":"Vocabulary","difficulty":"mudah","question":"Which word means a baby cat?","correct":"kitten","answers":["calf","puppy","chick","kitten"],"explanation":"The correct word is “kitten”.","concept":"vocab-1","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08892","topic":"Prepositions","difficulty":"mudah","question":"The book is ___ the table.","correct":"on","answers":["at","between","from","on"],"explanation":"“on” fits the location or direction in this sentence.","concept":"prep-0","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08778","topic":"Vocabulary","difficulty":"mudah","question":"Which word means a person who teaches pupils?","correct":"teacher","answers":["farmer","teacher","pilot","chef"],"explanation":"The correct word is “teacher”.","concept":"vocab-2","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08807","topic":"Grammar","difficulty":"mudah","question":"They ___ happy.","correct":"are","answers":["is","am","are","be"],"explanation":"The plural subject “they” takes “are”.","concept":"grammar-1","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08880","topic":"Tenses","difficulty":"sederhana","question":"Now, the children are ___ in the park.","correct":"playing","answers":["played","playing","plays","play"],"explanation":"After “are”, use the -ing form for an action happening now.","concept":"tense-4","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08991","topic":"Comprehension","difficulty":"sederhana","question":"Read: “Maya wakes up at seven o’clock. She eats breakfast before going to school.”\n\nWhat does Maya do before school?","correct":"She eats breakfast.","answers":["She goes to bed.","She goes swimming.","She watches a movie.","She eats breakfast."],"explanation":"The passage states that Maya eats breakfast before school.","concept":"comp-1","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08911","topic":"Prepositions","difficulty":"mudah","question":"The ball is ___ the two chairs.","correct":"between","answers":["into","from","under","between"],"explanation":"“between” fits the location or direction in this sentence.","concept":"prep-3","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08722","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “fast” is…","correct":"slow","answers":["dirty","early","strong","slow"],"explanation":"“slow” is the opposite of “fast”.","concept":"ant-fast","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08760","topic":"Vocabulary","difficulty":"mudah","question":"Which word means a place where we borrow books?","correct":"library","answers":["kitchen","garage","clinic","library"],"explanation":"The correct word is “library”.","concept":"vocab-0","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08848","topic":"Tenses","difficulty":"sederhana","question":"Yesterday, Amir ___ football.","correct":"played","answers":["plays","playing","play","played"],"explanation":"“Yesterday” signals past tense, so use “played”.","concept":"tense-0","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08789","topic":"Vocabulary","difficulty":"mudah","question":"Which word means an animal that gives us milk?","correct":"cow","answers":["eagle","shark","ant","cow"],"explanation":"The correct word is “cow”.","concept":"vocab-4","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08726","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “happy” is…","correct":"sad","answers":["clean","sad","slow","cold"],"explanation":"“sad” is the opposite of “happy”.","concept":"ant-happy","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08947","topic":"Sentence","difficulty":"mudah","question":"Choose the correct sentence.","correct":"We are going to the market.","answers":["We are going to the market.","We going are the market.","Are we going market the.","We is going market."],"explanation":"This sentence has correct subject-verb agreement and word order.","concept":"sentence-1","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08997","topic":"Comprehension","difficulty":"sederhana","question":"Read: “The pupils planted five trees behind the school. They water the trees every afternoon.”\n\nWhere did the pupils plant the trees?","correct":"Behind the school.","answers":["In the classroom.","Beside a hospital.","Behind the school.","At the market."],"explanation":"The location is stated directly in the passage.","concept":"comp-2","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08780","topic":"Vocabulary","difficulty":"mudah","question":"Which word means a place where doctors treat patients?","correct":"hospital","answers":["hospital","stadium","library","market"],"explanation":"The correct word is “hospital”.","concept":"vocab-3","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08904","topic":"Prepositions","difficulty":"mudah","question":"Ali walks ___ school.","correct":"to","answers":["from","to","in","on"],"explanation":"“to” fits the location or direction in this sentence.","concept":"prep-2","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08710","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “hot” is…","correct":"cold","answers":["cold","young","weak","late"],"explanation":"“cold” is the opposite of “hot”.","concept":"ant-hot","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08747","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “near” is…","correct":"far","answers":["dirty","far","old","heavy"],"explanation":"“far” is the opposite of “near”.","concept":"ant-near","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08734","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “clean” is…","correct":"dirty","answers":["fast","dirty","sad","clean"],"explanation":"“dirty” is the opposite of “clean”.","concept":"ant-clean","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"},{"id":"EN-6-08753","topic":"Vocabulary","difficulty":"mudah","question":"The opposite of “light” is…","correct":"heavy","answers":["small","strong","heavy","near"],"explanation":"“heavy” is the opposite of “light”.","concept":"ant-light","qa":"v10-reviewed","source":"LatihKu Original","alignment":"KPM-aligned","itemType":"mcq"}]}